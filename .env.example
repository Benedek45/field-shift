# Copy to .env (gitignored) and fill in. Never commit real credentials.

# NASA Earthdata login (AppEEARS, Giovanni, SMAP, IMERG, MODIS, ECOSTRESS)
# Free, instant: https://urs.earthdata.nasa.gov/users/new
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# USDA NASS QuickStats API key (county yields / acreage)
# Free, instant: https://quickstats.nass.usda.gov/api
NASS_API_KEY=
