# Advisor model keys. Copy to fieldshift.env (gitignored) and fill in only what you use.
# The environment wins over this file; .env and .agent-env are read too, in that order after this file.
# See README "Choosing a model and API key". Never commit real keys.

# OpenCode Go (opencode-go/*); OPENCODE_GO_API_KEY is accepted as an alias.
OPENCODE_API_KEY=
# OpenRouter (openrouter/<OpenRouter model id>, e.g. openrouter/openai/gpt-6-luna)
OPENROUTER_API_KEY=
# Anthropic API (anthropic/*) and OpenAI API (openai/*); subscription logins are not supported.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Other catalog providers, for example:
GEMINI_API_KEY=
XAI_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=
GROQ_API_KEY=

# Custom OpenAI-compatible endpoint (custom/<model id>); localhost is rewritten for the container.
FIELDSHIFT_BASE_URL=
FIELDSHIFT_API_KEY=
